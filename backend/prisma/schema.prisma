// Prisma Schema for Friends App (PostgreSQL + PostGIS)
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum UserRole {
  USER
  CELEBRITY
  ORGANIZATION
  SUPPORT
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  BLOCKED
  LIMITED
  SUSPENDED
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  OFFLINE
}

enum MediaType {
  PHOTO
  VIDEO
}

enum CallType {
  RANDOM_AUDIO
  RANDOM_VIDEO
  CELEBRITY_AUDIO
  CELEBRITY_VIDEO
  SUPPORT_AUDIO
}

enum RestrictionType {
  BLOCK_ACCOUNT
  BAN_RANDOM_AUDIO
  BAN_RANDOM_VIDEO
  BAN_EVENT_POST
  RATE_LIMIT
}

model User {
  id                  String               @id @default(uuid())
  phone               String               @unique
  role                UserRole             @default(USER)
  displayName         String
  avatarUrl           String?
  language            String               @default("Malayalam")
  city                String               @default("Kochi")
  latitude            Float                @default(9.9312)
  longitude           Float                @default(76.2673)
  isVerified          Boolean              @default(true)
  isPremium           Boolean              @default(false)
  premiumPlanName     String?
  premiumExpiresAt    DateTime?
  walletCoins         Int                  @default(100)
  status              AccountStatus        @default(ACTIVE)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  celebrityProfile    CelebrityProfile?
  organizationProfile OrganizationProfile?
  eventBookings       EventBooking[]
  initiatedCalls      CallSession[]        @relation("CallerRelation")
  receivedCalls       CallSession[]        @relation("ReceiverRelation")
  supportTickets      SupportTicket[]      @relation("TicketCreator")
  assignedTickets     SupportTicket[]      @relation("TicketAgent")
  restrictions        UserRestriction[]    @relation("RestrictedUser")
  appliedRestrictions UserRestriction[]    @relation("AdminModerator")
}

model CelebrityProfile {
  id                String             @id @default(uuid())
  userId            String             @unique
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category          String
  bio               String
  audioRatePerMin   Int                @default(25)
  videoRatePerMin   Int                @default(60)
  availability      AvailabilityStatus @default(AVAILABLE)
  isApprovedByAdmin Boolean            @default(false)
  followersCount    Int                @default(0)
  totalEarningsCoins Int               @default(0)
  mediaGallery      CelebrityMedia[]
}

model CelebrityMedia {
  id           String           @id @default(uuid())
  celebrityId  String
  celebrity    CelebrityProfile @relation(fields: [celebrityId], references: [id], onDelete: Cascade)
  mediaType    MediaType
  url          String
  thumbnailUrl String?
  caption      String
  likesCount   Int              @default(0)
  createdAt    DateTime         @default(now())
}

model OrganizationProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName        String
  registrationNumber String
  website            String?
  isApprovedByAdmin  Boolean  @default(false)
  events             Event[]
}

model Event {
  id             String              @id @default(uuid())
  organizationId String
  organization   OrganizationProfile @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  description    String
  category       String
  bannerUrl      String?
  venueName      String
  city           String
  latitude       Float
  longitude      Float
  startTime      DateTime
  endTime        DateTime
  ticketPrice    Float
  totalCapacity  Int
  bookedCount    Int                 @default(0)
  status         String              @default("PUBLISHED")
  createdAt      DateTime            @default(now())
  bookings       EventBooking[]
}

model EventBooking {
  id            String   @id @default(uuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticketCount   Int
  totalAmount   Float
  paymentStatus String   @default("PAID")
  paymentRef    String
  qrCodeHash    String   @unique
  bookedAt      DateTime @default(now())
}

model CallSession {
  id              String    @id @default(uuid())
  callType        CallType
  callerId        String
  caller          User      @relation("CallerRelation", fields: [callerId], references: [id])
  receiverId      String
  receiver        User      @relation("ReceiverRelation", fields: [receiverId], references: [id])
  roomId          String    @unique
  status          String    @default("RINGING") // RINGING, ACTIVE, ENDED, REJECTED
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  durationSeconds Int       @default(0)
  coinsCharged    Int       @default(0)
}

model SupportTicket {
  id            String           @id @default(uuid())
  creatorId     String
  creator       User             @relation("TicketCreator", fields: [creatorId], references: [id])
  creatorRole   UserRole
  assignedAgentId String?
  assignedAgent User?            @relation("TicketAgent", fields: [assignedAgentId], references: [id])
  subject       String
  status        String           @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  allowAudioCall Boolean         @default(true)
  createdAt     DateTime         @default(now())
  messages      SupportMessage[]
}

model SupportMessage {
  id         String        @id @default(uuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId   String
  senderName String
  senderRole UserRole
  content    String
  createdAt  DateTime      @default(now())
}

model UserRestriction {
  id              String          @id @default(uuid())
  targetUserId    String
  targetUser      User            @relation("RestrictedUser", fields: [targetUserId], references: [id])
  adminUserId     String
  adminUser       User            @relation("AdminModerator", fields: [adminUserId], references: [id])
  restrictionType RestrictionType
  reason          String
  active          Boolean         @default(true)
  expiresAt       DateTime?
  createdAt       DateTime        @default(now())
}
